{
  "name": "sismo-abierto",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "content/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "check": "biome check . && bun run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run --cwd apps/web typecheck",
    "test": "bun test packages apps/cli apps/cli-alias content",
    "test:e2e": "bun run build && bun run --cwd apps/web test:e2e",
    "build": "bun run --cwd apps/web build",
    "audit:historical": "bun packages/audit/src/run-historical.ts",
    "drift": "bun scripts/check-source-drift.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "typescript": "^5.8.3"
  }
}
